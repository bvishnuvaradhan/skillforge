datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  student
  mentor
  admin
}

enum Plan {
  free
  premium
}

enum Goal {
  placements
  competitive
  dsa
  interviews
}

enum PrivacySetting {
  private
  team
  public
}

enum Provider {
  google
  github
}

enum CodingPlatform {
  leetcode
  codeforces
  codechef
  github
}

enum LearningStyle {
  visual
  game_based
  reading
  problem_first
}

enum ExamType {
  ONBOARDING_ASSESSMENT
  CHECKPOINT
  REASSESSMENT
  FINAL_EVALUATION
  topic
  full_dsa
  competitive
  company
  adaptive
}

enum WorldStatus {
  draft
  published
  archived
}

enum LessonStatus {
  draft
  published
}

enum GameType {
  logic_builder
  loop_builder
  bfs_explorer
  dfs_adventure
  recursion_maze
  sliding_window
  dp_builder
  graph_puzzle
  greedy_arena
  ifelse_constructor
  function_workshop
  stream_matching
  type_sorter
  echo_chamber
  switchboard
  factory_line
  black_box_factory
  mirror_halls
  bug_hunt
  object_foundry
  wire_register
  heap_heist
  test_case_tower
  constructor_chain
  shape_shifter_arena
  vault_keeper
  interface_bridge
  assembly_yard
  pattern_forge
  solid_foundations
  refactor_run
  code_review_court
}

enum BossLevel {
  mini
  world
  grand
}

enum BadgeRarity {
  common
  rare
  epic
  legendary
}

enum WorldProgressStatus {
  locked
  unlocked
  in_progress
  completed
}

enum AccessTier {
  free
  premium
}

enum LanguageTrack {
  C
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String          @unique
  passwordHash       String?         @map("password_hash")
  name               String
  avatarUrl          String?         @map("avatar_url")
  role               Role
  plan               Plan            @default(free)
  planExpiresAt      DateTime?       @map("plan_expires_at")
  primaryGoal        Goal?           @map("primary_goal")
  onboardingComplete Boolean         @default(false) @map("onboarding_complete")
  languageTrack      LanguageTrack?  @map("language_track")
  streakCount        Int             @default(0) @map("streak_count")
  lastActiveAt       DateTime?       @map("last_active_at")
  privacySetting     PrivacySetting  @default(private) @map("privacy_setting")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")
  selectedModel      String?         @map("selected_model")

  oauthAccounts      OauthAccount[]
  sessions           Session[]
  codingProfiles     CodingProfile[]
  dltState           DltState?
  roadmap            Roadmap?
  masteryScores      MasteryScore[]
  examAttempts       ExamAttempt[]
  worldProgress      UserWorldProgress[]
  gameAttempts       GameAttempt[]
  bossAttempts       BossAttempt[]
  userBadges         UserBadge[]
  retentionScores    RetentionScore[]
  recommendations    Recommendation[]
  skillDna           SkillDna?
  forecasts          Forecast[]
  notifications      Notification[]
  studentSessions    InterviewSession[]  @relation("StudentSessions")
  mentorSessions     InterviewSession[]  @relation("MentorSessions")
  evaluatorFeedbacks InterviewFeedback[] @relation("EvaluatorFeedbacks")
  studentReviews     MentorReview[]      @relation("StudentReviews")
  mentorReviews      MentorReview[]      @relation("MentorReviews")
  mentorProfile      MentorProfile?
  resumes            Resume[]

  @@index([role])
  @@map("users")
}

model OauthAccount {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  provider     Provider
  providerId   String   @map("provider_id")
  accessToken  String?  @map("access_token")
  refreshToken String?  @map("refresh_token")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model CodingProfile {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  platform     CodingPlatform
  username     String
  solvedCount  Int            @default(0) @map("solved_count")
  rating       Int?
  lastSyncedAt DateTime?      @map("last_synced_at")
  rawData      Json?          @map("raw_data")
  createdAt    DateTime       @default(now()) @map("created_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("coding_profiles")
}

model DltState {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @unique @map("user_id") @db.Uuid
  knowledgeState     Json           @default("{}") @map("knowledge_state")
  overallMastery     Float          @default(0) @map("overall_mastery")
  overallRetention   Float          @default(0) @map("overall_retention")
  learningStyle      LearningStyle? @map("learning_style")
  consistencyScore   Float          @default(0) @map("consistency_score")
  careerReadiness    Json           @default("{}") @map("career_readiness")
  placementReadiness Float          @default(0) @map("placement_readiness")
  xpTotal            Int            @default(0) @map("xp_total")
  level              Int            @default(1)
  lastComputedAt     DateTime       @default(now()) @map("last_computed_at")
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at")

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dlt_states")
}

model Roadmap {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  goal              Goal
  steps             Json
  currentStepIndex  Int      @default(0) @map("current_step_index")
  generatedAt       DateTime @default(now()) @map("generated_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("roadmaps")
}

model MasteryScore {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  topicId          String    @map("topic_id")
  score            Float     @default(0)
  gameScore        Float     @default(0) @map("game_score")
  assessmentScore  Float     @default(0) @map("assessment_score")
  codingScore      Float     @default(0) @map("coding_score")
  interviewScore   Float     @default(0) @map("interview_score")
  retentionScore   Float     @default(0) @map("retention_score")
  lastActivityAt   DateTime? @map("last_activity_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, topicId])
  @@map("mastery_scores")
}

model ExamAttempt {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  examId        String?     @map("exam_id") @db.Uuid
  examType      ExamType    @default(ONBOARDING_ASSESSMENT) @map("exam_type")
  answers       Json        // Array of answers
  score         Float?      // Out of maxScore (onboarding) or absolute score (0.0-1.0)
  maxScore      Float?      @map("max_score")
  passed        Boolean     @default(false)
  timeSeconds   Int?        @map("time_seconds")
  topicScores   Json?       @map("topic_scores")
  startedAt     DateTime?   @map("started_at")
  submittedAt   DateTime    @default(now()) @map("submitted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examType])
  @@index([submittedAt])
  @@index([userId, examType, submittedAt])
  @@map("exam_attempts")
}

model World {
  id             String              @id @default(uuid()) @db.Uuid
  slug           String              @unique
  name           String
  description    String
  orderIndex     Int                 @map("order_index")
  status         WorldStatus         @default(draft)
  unlockCriteria Json                @map("unlock_criteria")
  xpReward       Int                 @default(0) @map("xp_reward")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at")

  lessons        Lesson[]
  games          Game[]
  bossBattles    BossBattle[]
  progressEntries UserWorldProgress[]

  @@index([slug])
  @@map("worlds")
}

model Lesson {
  id               String        @id @default(uuid()) @db.Uuid
  worldId          String        @map("world_id") @db.Uuid
  title            String
  content          Json
  orderIndex       Int           @map("order_index")
  estimatedMinutes Int           @default(10) @map("estimated_minutes")
  topicTags        String[]      @map("topic_tags")
  status           LessonStatus  @default(draft)
  languageTrack    LanguageTrack @default(JAVASCRIPT) @map("language_track")
  createdAt        DateTime      @default(now()) @map("created_at")

  world            World        @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId])
  @@map("lessons")
}

model Game {
  id                  String        @id @default(uuid()) @db.Uuid
  worldId             String        @map("world_id") @db.Uuid
  name                String
  gameType            GameType      @map("game_type")
  config              Json
  topicTags           String[]      @map("topic_tags")
  masteryContribution Float         @default(0.3) @map("mastery_contribution")
  xpReward            Int           @default(50) @map("xp_reward")
  orderIndex          Int           @map("order_index")
  tier                AccessTier    @default(free)
  createdAt           DateTime      @default(now()) @map("created_at")

  world               World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  attempts            GameAttempt[]

  @@index([worldId])
  @@map("games")
}

model BossBattle {
  id                  String         @id @default(uuid()) @db.Uuid
  worldId             String         @map("world_id") @db.Uuid
  name                String
  level               BossLevel
  questions           Json
  passThreshold       Float          @default(0.8) @map("pass_threshold")
  xpReward            Int            @map("xp_reward")
  badgeId             String?        @map("badge_id") @db.Uuid
  requiresHumanReview Boolean        @default(false) @map("requires_human_review")
  createdAt           DateTime       @default(now()) @map("created_at")

  world               World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  badge               Badge?         @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  attempts            BossAttempt[]

  @@index([worldId])
  @@index([badgeId])
  @@map("boss_battles")
}

model Badge {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String
  imageUrl    String        @map("image_url")
  rarity      BadgeRarity   @default(common)
  isSecret    Boolean       @default(false) @map("is_secret")
  createdAt   DateTime      @default(now()) @map("created_at")

  bossBattles BossBattle[]
  userBadges  UserBadge[]

  @@map("badges")
}

model UserWorldProgress {
  id                        String              @id @default(uuid()) @db.Uuid
  userId                    String              @map("user_id") @db.Uuid
  worldId                   String              @map("world_id") @db.Uuid
  status                    WorldProgressStatus @default(locked)
  unlockedAt                DateTime?           @map("unlocked_at")
  completedAt               DateTime?           @map("completed_at")
  lessonsCompleted          Int                 @default(0) @map("lessons_completed")
  gamesCompleted            Int                 @default(0) @map("games_completed")
  originalProblemsCompleted String[]            @default([]) @map("original_problems_completed")
  externalProblemsCompleted String[]            @default([]) @map("external_problems_completed")
  xpEarned                  Int                 @default(0) @map("xp_earned")
  drafts                    Json                @default("{}") @map("drafts")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @default(now()) @updatedAt @map("updated_at")

  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  world                     World               @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
  @@index([userId])
  @@index([worldId])
  @@map("user_world_progress")
}

model GameAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  gameId        String   @map("game_id") @db.Uuid
  score         Float
  hintsUsed     Int      @default(0) @map("hints_used")
  timeSeconds   Int      @map("time_seconds")
  passed        Boolean
  attemptNumber Int      @default(1) @map("attempt_number")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gameId])
  @@index([userId, gameId])
  @@map("game_attempts")
}

model BossAttempt {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  bossId        String      @map("boss_id") @db.Uuid
  score         Float
  passed        Boolean
  answers       Json
  timeSeconds   Int         @map("time_seconds")
  attemptNumber Int         @default(1) @map("attempt_number")
  createdAt     DateTime    @default(now()) @map("created_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boss          BossBattle  @relation(fields: [bossId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bossId])
  @@index([userId, bossId])
  @@map("boss_attempts")
}

model UserBadge {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  badgeId  String   @map("badge_id") @db.Uuid
  earnedAt DateTime @default(now()) @map("earned_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum RecommendationType {
  learn
  review
  practice
  reinforce
  interview
  career
  consistency
}

enum RecommendationImpact {
  low
  medium
  high
}

enum RecommendationStatus {
  active
  dismissed
  snoozed
  completed
}

enum ConsistencyPattern {
  daily
  bursty
  irregular
}

enum ExplorationBehavior {
  deep
  broad
  balanced
}

enum ForecastType {
  topic_readiness
  retention_risk
  rating_growth
  placement
  interview
}

enum NotificationType {
  memory
  streak
  interview
  roadmap
  inactivity
  system
  achievement
}

model RetentionScore {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  topicId        String    @map("topic_id")
  retention      Float     @default(1.0)
  stability      Float     @default(1.0)
  lastReviewedAt DateTime  @map("last_reviewed_at")
  nextReviewAt   DateTime  @map("next_review_at")
  reviewCount    Int       @default(0) @map("review_count")
  riskLevel      RiskLevel @default(low) @map("risk_level")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([nextReviewAt])
  @@map("retention_scores")
}

model Recommendation {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  type          RecommendationType
  title         String
  description   String
  why           String
  impact        RecommendationImpact
  effortMinutes Int                  @map("effort_minutes")
  confidence    Float
  topicId       String?              @map("topic_id")
  actionUrl     String?              @map("action_url")
  status        RecommendationStatus @default(active)
  snoozedUntil  DateTime?            @map("snoozed_until")
  cooldownUntil DateTime?            @map("cooldown_until")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recommendations")
}

model SkillDna {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @unique @map("user_id") @db.Uuid
  learningStyle       LearningStyle?       @map("learning_style")
  consistencyPattern  ConsistencyPattern?  @map("consistency_pattern")
  explorationBehavior ExplorationBehavior? @map("exploration_behavior")
  strengths           String[]             @default([])
  weaknesses          String[]             @default([])
  growthOpportunities String[]             @default([]) @map("growth_opportunities")
  computedAt          DateTime             @default(now()) @map("computed_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("skill_dna")
}

model Forecast {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  type             ForecastType
  topicId          String?      @map("topic_id")
  predictedValue   Float        @map("predicted_value")
  predictedAtDate  DateTime     @map("predicted_at_date") @db.Date
  confidence       Float
  createdAt        DateTime     @default(now()) @map("created_at")

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("forecasts")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  actionUrl String?          @map("action_url")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

enum InterviewSessionType {
  ai
  human
}

enum InterviewType {
  dsa
  coding
  system_design
  behavioral
  hr
}

enum InterviewStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum MentorRecommendation {
  ready
  needs_prep
  strong_candidate
}

enum MentorVerificationStatus {
  pending
  approved
  rejected
  suspended
}

enum ResumeTemplate {
  ats
  product
  fresher
  experienced
}

enum ExamCategory {
  topic
  full_dsa
  competitive
  company
  adaptive
}

model InterviewSession {
  id               String           @id @default(uuid()) @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  mentorId         String?          @map("mentor_id") @db.Uuid
  type             InterviewSessionType
  interviewType    InterviewType    @map("interview_type")
  targetCompany    String?          @map("target_company")
  status           InterviewStatus  @default(scheduled)
  scheduledAt      DateTime?        @map("scheduled_at")
  startedAt        DateTime?        @map("started_at")
  endedAt          DateTime?        @map("ended_at")
  recordingUrl     String?          @map("recording_url")
  recordingConsent Boolean          @default(false) @map("recording_consent")
  pricePaid        Decimal?         @map("price_paid") @db.Decimal(10, 2)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")

  student          User             @relation("StudentSessions", fields: [studentId], references: [id], onDelete: Cascade)
  mentor           User?            @relation("MentorSessions", fields: [mentorId], references: [id], onDelete: SetNull)
  feedback         InterviewFeedback?
  reviews          MentorReview[]

  @@index([studentId])
  @@index([mentorId])
  @@index([status])
  @@map("interview_sessions")
}

model InterviewFeedback {
  id                  String                @id @default(uuid()) @db.Uuid
  sessionId           String                @unique @map("session_id") @db.Uuid
  evaluatorId         String                @map("evaluator_id") @db.Uuid
  technicalScore      Float                 @map("technical_score")
  problemSolvingScore Float                 @map("problem_solving_score")
  communicationScore  Float                 @map("communication_score")
  confidenceScore     Float                 @map("confidence_score")
  overallScore        Float                 @map("overall_score")
  strengths           String
  improvements        String
  nextSteps           String                @map("next_steps")
  recommendation      MentorRecommendation?
  createdAt           DateTime              @default(now()) @map("created_at")

  session             InterviewSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluator           User                  @relation("EvaluatorFeedbacks", fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@map("interview_feedback")
}

model MentorProfile {
  id                     String                   @id @default(uuid()) @db.Uuid
  userId                 String                   @unique @map("user_id") @db.Uuid
  bio                    String
  headline               String
  expertise              String[]
  experienceYears        Int                      @map("experience_years")
  sessionPrice           Decimal                  @map("session_price") @db.Decimal(10, 2)
  sessionDurationMinutes Int                      @default(60) @map("session_duration_minutes")
  ratingAverage          Float                    @default(0) @map("rating_average")
  ratingCount            Int                      @default(0) @map("rating_count")
  rebookingRate          Float                    @default(0) @map("rebooking_rate")
  verificationStatus     MentorVerificationStatus @default(pending) @map("verification_status")
  verifiedAt             DateTime?                @map("verified_at")
  totalEarned            Decimal                  @default(0) @map("total_earned") @db.Decimal(12, 2)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at")

  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilities         MentorAvailability[]

  @@map("mentor_profiles")
}

model MentorAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  mentorId    String   @map("mentor_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  mentor      MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("mentor_availabilities")
}

model MentorReview {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  mentorId  String   @map("mentor_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User             @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)
  mentor    User             @relation("MentorReviews", fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("mentor_reviews")
}

model Resume {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  name      String         @default("My Resume")
  template  ResumeTemplate
  content   Json
  pdfUrl    String?        @map("pdf_url")
  isPrimary Boolean        @default(false) @map("is_primary")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores    ResumeScore[]

  @@map("resumes")
}

model ResumeScore {
  id                       String   @id @default(uuid()) @db.Uuid
  resumeId                 String   @map("resume_id") @db.Uuid
  overallScore             Float    @map("overall_score")
  atsScore                 Float    @map("ats_score")
  technicalScore           Float    @map("technical_score")
  projectScore             Float    @map("project_score")
  completenessScore        Float    @map("completeness_score")
  interviewReadinessScore  Float    @map("interview_readiness_score")
  suggestions              Json
  computedAt               DateTime @default(now()) @map("computed_at")

  resume                   Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_scores")
}
